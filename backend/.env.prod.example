# Docker image pulled by docker-compose.prod.yml
BACKEND_IMAGE=(Docker Hub image name, e.g. your-dockerhub-id/pricewatch-backend:latest)

# Spring profile
SPRING_PROFILES_ACTIVE=prod

# RDS MySQL
DB_URL=(RDS MySQL JDBC URL, e.g. jdbc:mysql://your-rds-endpoint.ap-northeast-2.rds.amazonaws.com:3306/pricewatch?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=utf8)
DB_USERNAME=(RDS DB username)
DB_PASSWORD=(RDS DB password)

# Redis container on EC2
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=1234

# Elasticsearch container on EC2
ELASTICSEARCH_URIS=http://elasticsearch:9200
PRODUCT_SEARCH_ES_ENABLED=true
PRODUCT_SEARCH_ES_MIN_SCORE=2.5
PRODUCT_SEARCH_ES_SYNC_FIXED_DELAY_MS=300000
ES_JAVA_OPTS=-Xms512m -Xmx512m

# JWT
JWT_SECRET=(Long random secret for JWT signing, at least 32 bytes recommended)
REFRESH_COOKIE_NAME=refreshToken
REFRESH_COOKIE_SECURE=false

# CORS
ALLOWED_ORIGINS=(Frontend origin, e.g. http://localhost:3000 or https://your-domain.com)

# Naver Shopping API
NAVER_BASE_URL=https://openapi.naver.com
NAVER_CLIENT_ID=(Naver Shopping API Client ID)
NAVER_CLIENT_SECRET=(Naver Shopping API Client Secret)
NAVER_SEARCH_DISPLAY=100
NAVER_DAILY_QUOTA=20000
NAVER_SEARCH_CACHE_TTL_SECONDS=1800

# Mail
MAIL_HOST=(SMTP host. Leave empty if mail dispatch is disabled)
MAIL_PORT=587
MAIL_USERNAME=(SMTP username. Leave empty if mail dispatch is disabled)
MAIL_PASSWORD=(SMTP password. Leave empty if mail dispatch is disabled)
EMAIL_DISPATCH_ENABLED=false
EMAIL_DISPATCH_DELAY_MS=10000
EMAIL_MAX_ATTEMPT=3

# Batch and thresholds
PRICE_BATCH_ENABLED=false
PRICE_BATCH_CRON=0 0 4 * * *
PRICE_BATCH_GROUP_PAGE_SIZE=500
PRICE_BATCH_SECOND_PASS_SIZE=1000
PRICE_DROP_RATE_THRESHOLD=10
DB_SEARCH_SCORE_THRESHOLD=70

# Debug archive
ARCHIVE_API_RESPONSES=false
API_REQUEST_DIR=apiRequests
